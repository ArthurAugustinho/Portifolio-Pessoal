# Copie para .env e preencha. Nunca versione o .env.

# Formulário de contato (ADR 0007). Estas quatro são secrets do Worker
# (wrangler secret put <NOME>); nunca vão para o repositório nem para o
# bundle do navegador. O remetente precisa ser de domínio verificado na
# Resend; onboarding@resend.dev só entrega para o e-mail dono da conta e
# serve apenas para teste (ver ADR 0010).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=

# Chave pública do Turnstile, lida no build do Next.js (aparece no
# navegador por design). Teste local: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Só para teste local do Worker: aponta o envio para um servidor simulado.
# Vazio em produção (cai em https://api.resend.com/emails).
RESEND_API_URL=

# URL pública do site, usada em metadata, robots.txt e sitemap.xml.
# Sem valor, cai no fallback http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Token do Cloudflare Web Analytics (ADR 0009), lido no build. Público por
# design. Vazio: o beacon não é carregado. Só carrega em produção.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# "true" só quando o conteúdo dos projetos deixar de ter TODO.
# Enquanto isso, o robots.txt bloqueia indexação. Com "true", o build
# falha se algum MDX ainda contiver "TODO:".
NEXT_PUBLIC_INDEXAVEL=
