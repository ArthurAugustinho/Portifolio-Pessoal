RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# URL pública do site, usada em metadata, robots.txt e sitemap.xml.
# Sem valor, cai no fallback http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# "true" só quando o conteúdo dos projetos deixar de ser TODO.
# Enquanto isso, o robots.txt bloqueia indexação (default false).
NEXT_PUBLIC_INDEXAVEL=false
