{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./out",
    // Estáticos saem direto do out/. O Worker só roda para /api/*.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Segredos (RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL e
  // TURNSTILE_SECRET_KEY) entram por `wrangler secret put`, nunca aqui.
  "observability": { "enabled": true }
}
